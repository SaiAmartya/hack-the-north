# Copy to .env and fill in. Never commit the filled version: .gitignore covers it.
# Every value below is optional; the defaults are the demo defaults.

# Gateway badge serial device. Leave empty to auto-detect by Espressif USB
# vendor ID, then by /dev/cu.usbmodem*. macOS renumbers this on every replug,
# so prefer auto-detection over pinning it.
PHANTOM_SERIAL_PORT=
PHANTOM_SERIAL_BAUDRATE=115200
PHANTOM_SERIAL_ENABLED=1

# Webcam
PHANTOM_CAMERA_INDEX=0
PHANTOM_CAMERA_ENABLED=1

# Arena Director. With no key the host uses its deterministic fallback, which is
# exactly what it does when OpenAI times out, so the demo still works offline.
PHANTOM_DIRECTOR_ENABLED=1
PHANTOM_OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# The websocket carries webcam frames and has no authentication. Keep this on
# loopback unless you genuinely want the venue network to see your camera.
PHANTOM_BIND_HOST=127.0.0.1
PHANTOM_BIND_PORT=8000
